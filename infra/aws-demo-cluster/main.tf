# Milestone 6 -- a real AWS-hosted Kubernetes cluster for the final demo
# recording. This is deliberately k3s on a free-tier EC2 instance, not EKS:
# EKS's control plane alone costs ~$73/month if left running, while this
# setup is $0/month within the 12-month Free Tier window (see
# docs/architecture.md section 5). `terraform apply` is a manual, deliberate
# step you run yourself -- nothing in this project's CI/pipeline applies
# this automatically, the same way the kind-cluster README already
# documents for AWS resources generated by the main pipeline.
terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.4"
    }
  }
}

provider "aws" {
  region  = var.aws_region
  profile = var.aws_profile
}

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"] # Canonical

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# A fresh key pair for this cluster -- the new AWS account has none of its
# own yet. The private key is generated locally and never sent anywhere
# except into AWS as the matching *public* key; see outputs.tf for how to
# retrieve it.
resource "tls_private_key" "k3s" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "k3s" {
  key_name   = "${var.project_tag}-key"
  public_key = tls_private_key.k3s.public_key_openssh

  tags = { Project = var.project_tag }
}

resource "local_sensitive_file" "private_key" {
  filename        = "${path.module}/k3s-demo-cluster-key.pem"
  content         = tls_private_key.k3s.private_key_pem
  file_permission = "0600"
}

# Allocated before the instance boots so k3s can bake it into the API
# server's TLS certificate at install time (see user_data.sh.tpl).
resource "aws_eip" "k3s" {
  domain = "vpc"
  tags   = { Project = var.project_tag }
}

resource "aws_security_group" "k3s" {
  name        = "${var.project_tag}-sg"
  description = "SSH + k3s API + NodePorts, restricted to one IP (see allowed_cidr)"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }

  ingress {
    description = "k3s / Kubernetes API"
    from_port   = 6443
    to_port     = 6443
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }

  ingress {
    description = "NodePort range, for reaching demo services directly"
    from_port   = 30000
    to_port     = 32767
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Project = var.project_tag }
}

resource "aws_instance" "k3s" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnets.default.ids[0]
  vpc_security_group_ids = [aws_security_group.k3s.id]
  key_name               = aws_key_pair.k3s.key_name

  user_data = templatefile("${path.module}/user_data.sh.tpl", {
    public_ip = aws_eip.k3s.public_ip
  })

  tags = {
    Project = var.project_tag
    Name    = "${var.project_tag}-node"
  }
}

resource "aws_eip_association" "k3s" {
  instance_id   = aws_instance.k3s.id
  allocation_id = aws_eip.k3s.id
}
