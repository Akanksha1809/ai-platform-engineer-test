# Generated by ai-platform-engineer -- Terraform Agent
# Service: {{ spec.service_name }}
# Do not hand-edit; re-run a new request to regenerate.

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "{{ spec.aws_region }}"
}

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

resource "aws_ecs_cluster" "this" {
  name = "{{ spec.service_name }}-cluster"
}

resource "aws_security_group" "service" {
  name        = "{{ spec.service_name }}-sg"
  description = "Allow inbound traffic to {{ spec.service_name }}"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    from_port   = {{ spec.container_port }}
    to_port     = {{ spec.container_port }}
    protocol    = "tcp"
{% if spec.public_endpoint %}
    cidr_blocks = ["0.0.0.0/0"]
{% else %}
    cidr_blocks = [data.aws_vpc.default.cidr_block]
{% endif %}
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_ecs_task_definition" "this" {
  family                   = "{{ spec.service_name }}"
  requires_compatibilities = ["FARGATE"]
  network_mode             = "awsvpc"
  cpu                       = "256"
  memory                    = "512"
  execution_role_arn        = aws_iam_role.execution.arn

  container_definitions = jsonencode([
    {
      name      = "{{ spec.service_name }}"
      image     = "{{ spec.container_image }}"
      essential = true
      portMappings = [
        {
          containerPort = {{ spec.container_port }}
          protocol      = "tcp"
        }
      ]
      environment = [
{% for key, value in spec.env.items() %}
        { name = "{{ key }}", value = "{{ value }}" }{{ "," if not loop.last else "" }}
{% endfor %}
      ]
    }
  ])
}

resource "aws_iam_role" "execution" {
  name = "{{ spec.service_name }}-execution-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy_attachment" "execution" {
  role       = aws_iam_role.execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_ecs_service" "this" {
  name            = "{{ spec.service_name }}"
  cluster         = aws_ecs_cluster.this.id
  task_definition = aws_ecs_task_definition.this.arn
  desired_count   = {{ spec.replicas }}
  launch_type     = "FARGATE"

  network_configuration {
    subnets          = data.aws_subnets.default.ids
    security_groups  = [aws_security_group.service.id]
    assign_public_ip = {{ "true" if spec.public_endpoint else "false" }}
  }
}
{% if "s3_bucket" in spec.cloud_resources %}

resource "aws_s3_bucket" "this" {
  bucket = "{{ spec.service_name }}-data-${data.aws_caller_identity.current.account_id}"
}

data "aws_caller_identity" "current" {}
{% endif %}
{% if "rds_postgres" in spec.cloud_resources %}

resource "aws_db_subnet_group" "this" {
  name       = "{{ spec.service_name }}-db-subnets"
  subnet_ids = data.aws_subnets.default.ids
}

resource "aws_db_instance" "this" {
  identifier             = "{{ spec.service_name }}-db"
  engine                 = "postgres"
  instance_class         = "db.t3.micro"
  allocated_storage      = 20
  db_name                = replace("{{ spec.service_name }}", "-", "_")
  username               = "app_user"
  manage_master_user_password = true
  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.service.id]
  skip_final_snapshot    = true
}
{% endif %}
{% if "sqs_queue" in spec.cloud_resources %}

resource "aws_sqs_queue" "this" {
  name = "{{ spec.service_name }}-queue"
}
{% endif %}
